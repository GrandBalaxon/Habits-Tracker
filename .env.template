# === Основные настройки Django ===
# Режим отладки (True для разработки, False для production)
DEBUG=

# Секретный ключ Django (сгенерируйте уникальный, не используйте в production публичный)
SECRET_KEY=

# === Настройки базы данных PostgreSQL ===
# Имя базы данных
POSTGRES_DB=
# Пользователь базы данных
POSTGRES_USER=
# Пароль пользователя базы данных
POSTGRES_PASSWORD=
# Хост базы данных (локально: localhost, в Docker: имя сервиса db)
POSTGRES_HOST=
# Порт базы данных (обычно 5432)
POSTGRES_PORT=

# === Настройки Celery / Redis ===
# URL брокера сообщений (для локального запуска: redis://localhost:6379, в Docker: redis://redis:6379)
CELERY_BROKER_URL=redis://localhost:6379
# URL для хранения результатов (аналогично брокеру)
CELERY_RESULT_BACKEND=redis://localhost:6379

# === Интеграция с Telegram ===
# Токен вашего Telegram-бота (получите у BotFather)
TELEGRAM_TOKEN=

# === CORS ===
# Разрешить запросы со всех источников (True/False). Для разработки можно True, для production – False и настроить CORS_ALLOWED_ORIGINS.
CORS_ALLOW_ALL_ORIGINS=